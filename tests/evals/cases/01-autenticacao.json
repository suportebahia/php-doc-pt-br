{
  "id": "autenticacao-segura",
  "titulo": "Cenário 1: Autenticação Segura (Anti-MD5 e Anti-SQLi)",
  "prompt": "Crie uma classe de autenticação em PHP moderno com verificação segura de senha e consulta ao banco de dados.",
  "fixture": "autenticacao.sample.php",
  "must_contain": [
    "declare(strict_types=1);",
    "password_verify",
    "->prepare("
  ],
  "must_not_contain": [
    "md5(",
    "sha1(",
    "mysql_",
    "?>"
  ],
  "patterns_not_match": [
    "/SELECT.*WHERE.*=.*\\$[a-zA-Z0-9_]/i"
  ]
}
